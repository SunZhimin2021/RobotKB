# ── Inference Services (Jetson AGX Orin 192.168.3.58) ────────────────────────
# 两个服务均为 OpenAI 兼容格式，无需 Bearer Token

# Embedding Service — bge-m3
# POST /v1/embeddings  {"model":"bge-m3","input":"text or [texts]"}
KB_EMBEDDING_URL=http://192.168.3.58:7997
KB_EMBEDDING_MODEL=bge-m3

# Reranker Service — bge-reranker-v2-m3
# POST /v1/rerank  {"model":"bge-reranker-v2-m3","query":"...","documents":["..."]}
KB_RERANKER_URL=http://192.168.3.58:7998
KB_RERANKER_MODEL=bge-reranker-v2-m3

# ── Storage Services (也在 Jetson 192.168.3.58) ───────────────────────────────
# 在 Jetson 本机运行应用时用 localhost；从开发机连接时用 192.168.3.58

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
# docker-compose 服务名：robotkb-postgres，端口 5432
POSTGRES_DB=robotkb
POSTGRES_USER=robotkb
POSTGRES_PASSWORD=change-me-strong-password
KB_PG_DSN=postgresql+asyncpg://robotkb:change-me-strong-password@localhost:5432/robotkb
# 开发机: KB_PG_DSN=postgresql+asyncpg://robotkb:change-me-strong-password@192.168.3.58:5432/robotkb

# ── Meilisearch ───────────────────────────────────────────────────────────────
# docker-compose 服务名：robotkb-meilisearch，端口 7700
MEILI_MASTER_KEY=change-me-master-key
KB_MEILI_URL=http://localhost:7700
KB_MEILI_API_KEY=change-me-master-key
# 开发机: KB_MEILI_URL=http://192.168.3.58:7700

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# docker-compose 服务名：robotkb-neo4j，端口 7474(HTTP) / 7687(Bolt)
# NEO4J_AUTH 格式：user/password
NEO4J_AUTH=neo4j/change-me-neo4j-password
KB_NEO4J_URI=bolt://localhost:7687
KB_NEO4J_USER=neo4j
KB_NEO4J_PASSWORD=change-me-neo4j-password
# 开发机: KB_NEO4J_URI=bolt://192.168.3.58:7687

# ── MinIO ─────────────────────────────────────────────────────────────────────
# docker-compose 服务名：robotkb-minio，端口 9000(API) / 9001(Web UI)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=robotkb
KB_MINIO_ENDPOINT=localhost:9000
KB_MINIO_ACCESS_KEY=minioadmin
KB_MINIO_SECRET_KEY=change-me-minio-password
KB_MINIO_BUCKET=robotkb
KB_MINIO_USE_SSL=false
# 开发机: KB_MINIO_ENDPOINT=192.168.3.58:9000

# ── Redis (阶段七 Celery broker) ──────────────────────────────────────────────
# docker-compose 服务名：robotkb-redis，端口 6379
REDIS_PASSWORD=change-me-redis-password
# KB_CELERY_BROKER_URL=redis://:change-me-redis-password@localhost:6379/0

# ── Retrieval tuning ──────────────────────────────────────────────────────────
KB_RRF_K=60
KB_RETRIEVAL_RECALL=20
KB_RERANK_TOP_N=10

# ── Auth ──────────────────────────────────────────────────────────────────────
KB_MCP_TOKEN_SECRET=change-me-mcp-token-secret
KB_API_JWT_SECRET=change-me-api-jwt-secret
